# NVIDIA Configuration
NVIDIA_API_KEY=your_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SPEECH_MODEL=nvidia/parakeet-rnnt-1.1b
